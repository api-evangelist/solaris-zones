            "FRAMEWORK_ERROR",
            "SNAPSHOT_ERROR",
            "COMMAND_ERROR",
            "RESOURCE_ALREADY_EXISTS",
            "RESOURCE_NOT_FOUND",
            "RESOURCE_TOO_MANY",
