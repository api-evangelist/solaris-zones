{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/VmCpuStats",
  "title": "VmCpuStats",
  "type": "object",
  "properties": {
    "cpu_nsec_idle": {
      "type": "integer",
      "format": "int64",
      "description": "Nanoseconds spent idle",
      "example": 10
    },
    "cpu_nsec_kernel": {
      "type": "integer",
      "format": "int64",
      "description": "Nanoseconds spent in kernel mode",
      "example": 10
    },
    "cpu_nsec_user": {
      "type": "integer",
      "format": "int64",
      "description": "Nanoseconds spent in user mode",
      "example": 10
    },
    "cpu_nsec_dtrace": {
      "type": "integer",
      "format": "int64",
      "description": "Nanoseconds spent in DTrace",
      "example": 10
    },
    "cpu_nsec_intr": {
      "type": "integer",
      "format": "int64",
      "description": "Nanoseconds spent handling interrupts",
      "example": 10
    }
  }
}