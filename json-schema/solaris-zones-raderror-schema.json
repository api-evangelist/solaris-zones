{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RadError",
  "title": "RadError",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "example": "failure"
    },
    "payload": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "example": "example_value"
    }
  }
}