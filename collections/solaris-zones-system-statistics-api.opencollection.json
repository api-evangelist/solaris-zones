{
  "opencollection": "1.0.0",
  "info": {
    "name": "Solaris Zones Oracle Solaris Kernel Zones Archive Creation System Statistics API",
    "version": "1.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "_rad_session",
      "value": "{{_rad_session}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "System Statistics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Solaris Zones Read System-wide Statistics",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{host}:{port}/api/com.oracle.solaris.rad.zonemgr/1.6/Store/_rad_method/readSystemStats",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Read system-wide performance statistics including total CPU, memory, I/O, and network utilization."
        },
        {
          "info": {
            "name": "Solaris Zones List All Kernel Statistics Interfaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}/api/com.oracle.solaris.rad.zonemgr/1.6/com.oracle.solaris.rad.kstat/2.0",
            "params": [
              {
                "name": "_rad_detail",
                "value": "",
                "type": "query",
                "description": "Include detailed property information"
              }
            ]
          },
          "docs": "Discover all available kernel statistics interfaces. Provides access to CPU, memory, network, and zone-specific resource utilization data."
        }
      ]
    }
  ],
  "bundled": true
}