  "info": {
    "_postman_id": "bf3e9c92-e543-43c0-bf65-bfaaa1a02015",
    "name": "Solaris Zones Oracle Solaris Unified Archives Zones Archive\u2026",
    "description": "REST API for creating, deploying, and managing Unified Archives for Oracle Solaris zone system recovery, cloning, and migration. Unified Archives package one or more system images (zones and global zone) into a single portable archive file that can be used for bare-metal recovery, zone cloning, zone deployment on new systems, and disaster recovery scenarios.\n\nContact Support:\n Name: Oracle Solaris Support\n Email: solaris-support@oracle.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T03:12:38.000Z",
