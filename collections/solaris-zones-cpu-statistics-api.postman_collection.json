  "info": {
    "_postman_id": "0c0996ae-0061-45a3-87e9-aefc7108f187",
    "name": "Solaris Zones Oracle Solaris Kernel Zones Archive Creation CPU Statistics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for creating and managing Oracle Solaris Kernel Zones via the RAD zonemgr module. Kernel Zones (brand solaris-kz) are non-global zones with their own kernel, providing greater independence and enhanced security isolation compared to native zones. They support live migration, independent patching, and hardware-assisted virtualization.\n\nContact Support:\n Name: Oracle Solaris Support\n Email: solaris-support@oracle.com",
      "type": "text/plain"
    }
  }
