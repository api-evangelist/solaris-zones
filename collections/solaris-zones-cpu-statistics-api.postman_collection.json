    "_postman_id": "6a649918-5acf-4686-8553-860e34a2318d",
    "name": "Solaris Zones Monitoring Statistics CPU Statistics API",
    "description": "REST API for retrieving zone resource utilization statistics on Oracle Solaris 11.4 systems. Provides access to the libzonestat functionality through the RAD REST interface, enabling programmatic retrieval of per-zone resource consumption data including physical memory, virtual memory, CPU utilization, and network I/O with sorting and filtering capabilities.\n\nContact Support:\n Name: Oracle Solaris Support\n Email: solaris-support@oracle.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
