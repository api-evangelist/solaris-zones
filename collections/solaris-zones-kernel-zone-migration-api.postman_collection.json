          "name": "Solaris Zones Live Migrate a Kernel Zone",
          "request": {
            "name": "Solaris Zones Live Migrate a Kernel Zone",
            "description": {
              "content": "Live migrate a running kernel zone to a remote host. Kernel zones are the primary zone type that supports live migration where the zone continues running while its state is transferred to the destination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Zone",
                ":zoneName",
                "_rad_method",
                "migrate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "zoneName",
                  "description": "(Required) Kernel zone name"
                },
                {
                  "description": "Solaris host running RAD",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "RAD REST API port",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
