  "info": {
    "_postman_id": "03affbfa-d8ce-4375-8874-894e5b065ade",
    "name": "Solaris Zones Oracle Solaris Kernel Zones Kernel Zone\u2026",
    "description": "REST API for creating and managing Oracle Solaris Kernel Zones via the RAD zonemgr module. Kernel Zones (brand solaris-kz) are non-global zones with their own kernel, providing greater independence and enhanced security isolation compared to native zones. They support live migration, independent patching, and hardware-assisted virtualization.\n\nContact Support:\n Name: Oracle Solaris Support\n Email: solaris-support@oracle.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
