          "id": "c0d06573-38b9-44b0-aaab-9df4959597f4",
          "name": "Solaris Zones Migrate Zone to a Remote Host",
          "request": {
            "name": "Solaris Zones Migrate Zone to a Remote Host",
            "description": {
              "content": "Migrate a zone to a remote host using either live or cold migration. Live migration keeps the zone running during transfer. Cold migration halts the zone first. Available since API version 1.1.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Zone",
                ":zoneName",
                "_rad_method",
                "migrate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
